# PostgreSQL Connection URL (Neon, Supabase, Local PostgreSQL, or Docker)
DATABASE_URL="postgresql://user:password@localhost:5432/hotel_inspection_db?sslmode=prefer"

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini Model Name (dynamically configurable, e.g., gemini-2.5-flash, gemini-1.5-flash, gemini-2.5-pro)
GEMINI_MODEL="gemini-2.5-flash"

# Port
PORT=3001